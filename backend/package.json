{
  "name": "pmfby-evidence-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PMFBY crop-survey farmer-communication, call-evidence and emergency-safety backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "migrate": "node-pg-migrate -j js -m src/db/migrations --envPath .env up",
    "migrate:down": "node-pg-migrate -j js -m src/db/migrations --envPath .env down",
    "migrate:test": "cross-env-shell DATABASE_URL=$TEST_DATABASE_URL node-pg-migrate -j js -m src/db/migrations up",
    "seed": "node seeds/seed.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand --forceExit tests/integration"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
