# Copy to .env and fill in real values. Never commit the real .env.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/pmfby_evidence
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/pmfby_evidence_test
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
# 32-byte key, base64-encoded, used for AES-256-GCM encryption of evidence files at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EVIDENCE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
STORAGE_ROOT=./storage
LOG_LEVEL=info
